# === Machine Role ===
MACHINE_ROLE=secondary
USECASE=two_machine_secondary

# === Primary Machine Addresses (MUST BE CONFIGURED) ===
# Replace <PRIMARY_IP> with the primary machine's IP address
PEER_MACHINE_ADDR=http://<PRIMARY_IP>:50052
ORCHESTRATOR_ADDR=http://<PRIMARY_IP>:50053
GLOBAL_SCHEDULER_ADDR=http://<PRIMARY_IP>:50054

# === GPU Configuration (RTX-5090) ===
SPLIT_THRESHOLD=32768
CHUNK_SIZE=4194304
MEM_POOL_RESERVE_SIZE=29000000000
GPU_TARGET_ARCHS=120
PICO_GPU_MEM=5090
USE_NEW_QUOTIENT=1
USE_CUSTOM_TRANSPOSE=1
CHUNK_BATCH_SIZE=1

# === Task Configuration ===
CPU_CHUNKS_PER_TASK_UNIT=8
MAX_BLOCKS=7200
SAVE_PROGRAM_POOL=false
MAX_NUM_TASKS=20

# === Block Selection ===
PROGRAM=reth
BLOCK_NUMBER=23264565
BENCH_RETH_BLOCK=23264565

# === Prover Configuration ===
PROVER_COUNT=8

# === Thread Configuration ===
NUM_THREADS=12
NUM_RISCV_PREPARERS=6
NUM_CONVERT_PREPARERS=12
NUM_CONBINE_PREPARERS=7

# === Memory Configuration ===
MEMORY_POOL_SIZE=140
MEMORY_RECYCLER_THREADS=4
CPU_EVENT_POOL_SIZE=200
RUST_MIN_STACK=16777216

# === Proving Control ===
VK_VERIFICATION=false
DONE_UNTIL_COMBINE=true
DISABLE_CORE_AFFINITY=1

# === Logging ===
RUST_LOG=info
RUST_BACKTRACE=full
